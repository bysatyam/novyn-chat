{
  "appId": "com.novyn.app",
  "appName": "Novyn",
  "webDir": "public",
  "server": {
    "url": "https://novyn-live.onrender.com"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#F7F9FC",
      "overlaysWebView": false
